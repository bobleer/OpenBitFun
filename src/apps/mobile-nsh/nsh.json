{
  "name": "OpenBitFun",
  "id": "com.openbitfun.mobile",
  "version": "2.0.0",
  "build": 1,
  "rust": "./native",
  "icon": "../../../assets/brand/exports/openbitfun-app-icon-1024.png",
  "capabilities": {
    "clipboard": true,
    "notifications": true,
    "picker": true,
    "share": true,
    "fs": {
      "read": ["${dataDir}/markdown-exports", "${dataDir}/image-exports", "${dataDir}/pdf-exports"],
      "write": ["${dataDir}/markdown-exports", "${dataDir}/image-exports", "${dataDir}/pdf-exports"]
    },
    "statusBar": true,
    "network": {
      "http": [
        {
          "host": "*",
          "methods": [
            "GET",
            "HEAD"
          ],
          "schemes": [
            "https",
            "http"
          ]
        }
      ]
    },
    "webview": {
      "hosts": [
        "*"
      ]
    },
    "openUrl": {
      "schemes": [
        "https",
        "http"
      ]
    }
  },
  "statusBar": {
    "foreground": "auto"
  }
}
